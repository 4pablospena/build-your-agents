# Public URL of the deployed site (no trailing slash)
# Used for og:url, absolute og:image, curl BASE on /docs, RSS, and sitemap
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub repository URL (no trailing slash) — footer, /help, issue links
NUXT_PUBLIC_REPO_URL=https://github.com/4pablospena/build-your-agents

# Optional build override (default: vercel on Vercel, node-server elsewhere)
# NITRO_PRESET=vercel
# NITRO_PRESET=node-server
